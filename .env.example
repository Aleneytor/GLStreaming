# === GL Streaming — variables de entorno (plantilla) ===
# Copia este archivo como .env.local y rellena los valores.
# .env.local NUNCA se sube al repositorio (ver .gitignore).
# En desarrollo, los valores de Supabase local los imprime `npx supabase start`.

# --- Supabase (público, llega al navegador) ---
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon key impresa por supabase start>"

# --- Supabase (solo servidor, NUNCA en el navegador) ---
# Se usa de forma mínima, explícita y auditada; jamás en código cliente.
SUPABASE_SERVICE_ROLE_KEY="<service_role key impresa por supabase start>"

# --- Cifrado de secretos de streaming a nivel de aplicación ---
# Clave AES-256-GCM en hex (32 bytes = 64 hex). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# La clave vive SOLO aquí, nunca junto al dato cifrado en Postgres.
GLS_ENCRYPTION_KEY="<64 caracteres hex>"

# --- Fuente de tasa paralela (Kuanto) — se activa más adelante ---
# Hasta rotar el secreto expuesto de Kuanto y en desarrollo local:
# usar datos simulados; no conectar al proyecto Kuanto en vivo.
KUANTO_SUPABASE_URL=""
KUANTO_SUPABASE_PUBLISHABLE_KEY=""

# --- Fuente de tasa BCV ---
BCV_API_URL="https://bcvscrapper.vercel.app/api/bcv"

# --- Zona horaria de negocio (fija por decisión de dominio) ---
APP_TIMEZONE="America/Caracas"
